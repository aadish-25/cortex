# ==============================================================================
# CORTEX (AAD-H1) — Environment Configuration
# ==============================================================================

# Core System Environment
ENVIRONMENT=development

# Database & Cache Infrastructure
DATABASE_URL=postgresql+asyncpg://cortex:cortex_dev_password@localhost:5432/cortex_db
REDIS_URL=redis://localhost:6379/0

# Vector Database (Qdrant)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# Security & Authentication
JWT_SECRET_KEY="KEY_PRESENT"
JWT_ALGORITHM=HS256

# ==============================================================================
# LLM Provider Gateway & Multi-Key Rotation Pool
# Priority Cascade: Groq (1st) -> OpenRouter (2nd) -> Gemini (3rd)
# Keys flagged with :NOTWORKING are automatically skipped by the rotator.
# ==============================================================================

# PRIORITY 1: GROQ (Fast inference, high throughput, zero-token cost)
GROQ_API_KEYS="KEY_PRESENT"
GROQ_API_KEY="KEY_PRESENT"
GROQ_DEFAULT_MODEL=groq/qwen/qwen3.8-27b

# PRIORITY 2: OPENROUTER (Only used as fallback, strictly on :free models)
OPENROUTER_API_KEYS="KEY_PRESENT"
OPENROUTER_API_KEY="KEY_PRESENT"
OPENROUTER_DEFAULT_MODEL=openrouter/nvidia/nemotron-3.5-lightning:free

# PRIORITY 3: GEMINI (Google AI Studio)
# Keys flagged with :NOTWORKING are inactive/disabled on free tier
GEMINI_API_KEYS="KEY_PRESENT"
GEMINI_API_KEY="KEY_PRESENT"
GEMINI_DEFAULT_MODEL=gemini/gemini-2.0-flash

# META / LLAMA API KEY
META_API_KEY="KEY_PRESENT"

# Active Gateway Configuration (Using Fast, Free Groq Engine)
DEFAULT_LLM_PROVIDER=groq
DEFAULT_LLM_MODEL=groq/qwen/qwen3.8-27b
FAST_ROUTING_MODEL=groq/qwen/qwen3.8-27b
SYNTHESIS_MODEL=groq/qwen/qwen3.8-27b


# ==========================================
# JIRA SERVICE MANAGEMENT (ATLASSIAN CLOUD)
# ==========================================
JIRA_BASE_URL=https://weareinterns.atlassian.net
JIRA_API_EMAIL="KEY_PRESENT"
JIRA_API_TOKEN="KEY_PRESENT"
JIRA_DEFAULT_PROJECT_KEY=ENG


# ==========================================
# EXTERNAL INTEGRATIONS (PHASE 6)
# ==========================================
GITHUB_API_TOKEN="KEY_PRESENT"
GITHUB_DEFAULT_REPO=aadish-25/cortex-testing
GOOGLE_DRIVE_API_KEY="KEY_PRESENT"
GOOGLE_DRIVE_ROOT_FOLDER_ID="KEY_PRESENT"
