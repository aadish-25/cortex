# Cortex local development configuration. Replace secrets before use.
ENVIRONMENT=development
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
POSTGRES_USER=cortex
POSTGRES_PASSWORD=cortex_dev_password
POSTGRES_DB=cortex_db

DATABASE_URL=postgresql+asyncpg://cortex:cortex_dev_password@localhost:5432/cortex_db
REDIS_URL=redis://localhost:6379/0
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

JWT_SECRET_KEY=replace-this-with-a-random-secret-at-least-32-characters-long
JWT_ALGORITHM=HS256
CORTEX_BOOTSTRAP_ADMIN_PASSWORD=

DEFAULT_LLM_PROVIDER=groq
DEFAULT_LLM_MODEL=groq/qwen/qwen3.8-27b
FAST_ROUTING_MODEL=groq/qwen/qwen3.8-27b
SYNTHESIS_MODEL=groq/qwen/qwen3.8-27b
GROQ_DEFAULT_MODEL=groq/qwen/qwen3.8-27b
OPENROUTER_DEFAULT_MODEL=openrouter/nvidia/nemotron-3.5-lightning:free
GEMINI_DEFAULT_MODEL=gemini/gemini-2.5-flash

GROQ_API_KEY=
GROQ_API_KEYS=
OPENROUTER_API_KEY=
OPENROUTER_API_KEYS=
GEMINI_API_KEY=
GEMINI_API_KEYS=
META_API_KEY=

JIRA_BASE_URL=
JIRA_API_EMAIL=
JIRA_API_TOKEN=
JIRA_DEFAULT_PROJECT_KEY=ENG

GITHUB_API_TOKEN=
GITHUB_DEFAULT_REPO=
GOOGLE_DRIVE_API_KEY=
GOOGLE_DRIVE_ROOT_FOLDER_ID=

# Cloudinary Cloud Storage Integration
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_ROOT_FOLDER=cortex
